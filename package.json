{
  "name": "@miraigent/free-ai-ops-mcp",
  "version": "0.1.27",
  "description": "Free MCP server for developers adding human review gates, prompt risk checks, FAQ review, and CRM note safety to AI tools.",
  "homepage": "https://github.com/Miraigent/miraigent-free-ai-ops-mcp",
  "type": "module",
  "private": false,
  "license": "MIT",
  "files": [
    "README.md",
    "LAUNCH_FLOW.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "examples/",
    "mcp/",
    "scripts/"
  ],
  "bin": {
    "free-ai-ops-mcp": "mcp/free-ai-ops-server.mjs"
  },
  "scripts": {
    "check": "node --check mcp/free-ai-ops-server.mjs && node --check scripts/smoke-test.mjs && node --check scripts/secret-scan.mjs && node scripts/secret-scan.mjs",
    "test": "node scripts/smoke-test.mjs",
    "example:human-review-gate": "node examples/human-review-gate/run-example.mjs",
    "example:prompt-risk-review": "node examples/prompt-risk-review/run-example.mjs",
    "example:faq-candidate-review": "node examples/faq-candidate-review/run-example.mjs",
    "example:ai-safe-crm-note": "node examples/ai-safe-crm-note/run-example.mjs",
    "mcp": "node mcp/free-ai-ops-server.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-operations",
    "human-review",
    "support-automation",
    "customer-support",
    "prompt-risk",
    "faq-review",
    "ai-safety",
    "crm",
    "faq",
    "ai-agent",
    "workflow-automation",
    "review-gate",
    "human-in-the-loop",
    "developer-tools",
    "claude-desktop",
    "cursor-mcp",
    "mcp-tools",
    "ai-agent-tools",
    "npx",
    "json-rpc",
    "mcp-json-rpc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miraigent/miraigent-free-ai-ops-mcp.git"
  },
